# OAuth2 Frontend Configuration
#
# These vars are inlined into the SPA bundle at `npm run build` time (Vite).
# In Docker production builds they are injected via build args (see
# deploy/docker/Dockerfile and docker-compose.prod.yml).
#
# VITE_API_BASE_URL: leave empty in production — the SPA is served same-origin
# behind nginx and uses relative paths (/api, /oauth2). Setting it breaks routing.
VITE_API_BASE_URL=
VITE_CLIENT_ID=fulla-portal
VITE_REDIRECT_URI=http://localhost:5173/callback

# External login providers (GitHub / Google / WeChat) — v1.4.0 provider tiers:
# configured SERVER-side now (config.json custom_config.external_auth, env
# aliases FULLA_EXTERNAL_TIER_DOMESTIC / FULLA_EXTERNAL_TIER_INTERNATIONAL).
# The login page renders its social buttons from GET /api/auth/providers at
# runtime, so no VITE_ variables are involved anymore.
