[conf]
drogon/*:tools.build:cflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
drogon/*:tools.build:cxxflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
drogon/*:tools.build:exelinkflags=["-fsanitize=thread"]
drogon/*:tools.build:sharedlinkflags=["-fsanitize=thread"]
drogon/*:tools.info.package_id:confs=["tools.build:cflags", "tools.build:cxxflags", "tools.build:exelinkflags", "tools.build:sharedlinkflags"]
trantor/*:tools.build:cflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
trantor/*:tools.build:cxxflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
trantor/*:tools.build:exelinkflags=["-fsanitize=thread"]
trantor/*:tools.build:sharedlinkflags=["-fsanitize=thread"]
trantor/*:tools.info.package_id:confs=["tools.build:cflags", "tools.build:cxxflags", "tools.build:exelinkflags", "tools.build:sharedlinkflags"]
