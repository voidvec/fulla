# Docker Compose Production Environment Variables
# Copy this file to .env.docker and fill in real values.
#
# Used by: docker-compose -f deploy/docker/docker-compose.prod.yml --env-file .env.docker
# All FULLA_* vars below are passed through to the backend container; the
# VITE_* vars are passed as build args to the frontend image.

# ===== Image version =====
# Tag for ghcr.io/voidvec/fulla-* images (default: latest).
# Pin to a release tag for reproducible deployments.
FULLA_VERSION=latest

# ===== Runtime mode =====
# production enables strict startup validation: HTTPS issuer + non-default
# passwords. MUST be paired with FULLA_ISSUER=https://... below, otherwise
# the backend refuses to start (ConfigManager.cc prod-mode validation).
FULLA_ENV=production
FULLA_ISSUER=https://auth.example.com

# ===== JWT signing key (REQUIRED for production) =====
# If neither is set, an ephemeral key is generated on each restart and ALL
# previously issued access/refresh tokens become invalid.
# Use one of:
#   FULLA_JWT_KEY_PATH  — path to an RSA private key file (mounted volume)
#   FULLA_SIGNING_KEY   — the PEM key material inline (alternative)
# The docker-compose.prod.yml mounts ../../deploy/keys at /app/keys:ro.
FULLA_JWT_KEY_PATH=/app/keys/signing.pem
# FULLA_SIGNING_KEY=

# ===== PostgreSQL =====
# NOTE: POSTGRES_* bootstrap the database container; FULLA_DB_* are read by
# the backend. The user/db/name values MUST match between the two groups.
# ⚠ POSTGRES_PASSWORD and FULLA_DB_PASSWORD must be kept identical:
#   - POSTGRES_PASSWORD initializes the PG container on first run
#   - FULLA_DB_PASSWORD is what the backend uses to connect
POSTGRES_USER=fulla_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fulla_db
FULLA_DB_HOST=fulla-postgres
FULLA_DB_PORT=5432
FULLA_DB_NAME=fulla_db
FULLA_DB_USER=fulla_user
FULLA_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Redis =====
# ⚠ REDIS_PASSWORD and FULLA_REDIS_PASSWORD must be kept identical:
#   - REDIS_PASSWORD is passed to the Redis container's --requirepass
#   - FULLA_REDIS_PASSWORD is what the backend uses to connect
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
FULLA_REDIS_HOST=fulla-redis
FULLA_REDIS_PORT=6379
FULLA_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===== Backend listener / frontend URL =====
FULLA_LISTEN_PORT=5555
FULLA_FRONTEND_URL=https://your-domain.com

# ===== CORS / OAuth redirect URIs (HTTPS domain required) =====
# Comma-separated list of allowed origins for the browser SPA.
FULLA_CORS_ALLOW_ORIGINS=https://your-domain.com
# fulla-portal redirect (single canonical URI; must match the OAuth client registration)
FULLA_PORTAL_REDIRECT_URI=https://your-domain.com/callback
FULLA_PORTAL_CLIENT_SECRET=CHANGE_ME_STRONG_SECRET
# Admin console client redirect (registered for the fulla-admin-console client)
FULLA_ADMIN_CONSOLE_REDIRECT_URI=https://your-domain.com/admin/callback
# Google OAuth redirect URI (must match Google Cloud Console configuration)
FULLA_GOOGLE_REDIRECT_URI=https://your-domain.com/callback

# ===== Migration / error verbosity =====
# Keep false in production: migrations run through the one-shot `migrate`
# service (compose profile "migrate") — see docs/operate/deployment.md.
FULLA_AUTO_MIGRATE=false
# When false, validation errors return a generic message (recommended for prod,
# avoids leaking field-level hints to attackers).
DETAILED_VALIDATION_ERRORS=false

# ===== External Auth (optional) =====
FULLA_GITHUB_CLIENT_ID=
FULLA_GITHUB_CLIENT_SECRET=
FULLA_GOOGLE_CLIENT_ID=
FULLA_GOOGLE_CLIENT_SECRET=
FULLA_WECHAT_APPID=
FULLA_WECHAT_SECRET=

# ===== Email / SMTP (optional - Console mode if unset) =====
# 未设置时邮件服务为 Console 模式（验证邮件只输出到后端日志，不真正发送）
# 设置后启用真实 SMTP 发送。163 邮箱需用授权码（非登录密码）。
FULLA_SMTP_HOST=smtp.163.com
FULLA_SMTP_PORT=465
FULLA_SMTP_USER=your-email@163.com
FULLA_SMTP_PASSWORD=your-authorization-code
FULLA_SMTP_FROM_NAME=Fulla
FULLA_SMTP_SSL=true

# ===== Frontend build-time vars (Vite; passed as build args) =====
# These are inlined into the SPA bundle at image build time, NOT read at runtime.
# VITE_API_BASE_URL MUST stay empty in production — the SPA is served same-origin
# behind nginx and uses relative paths (/api, /oauth2). Setting it breaks routing.
# ⚠ VITE_REDIRECT_URI and FULLA_PORTAL_REDIRECT_URI must be kept identical:
#   - VITE_REDIRECT_URI is compiled into the frontend SPA bundle
#   - FULLA_PORTAL_REDIRECT_URI is registered in the backend OAuth2Plugin config
VITE_API_BASE_URL=
VITE_CLIENT_ID=fulla-portal
VITE_REDIRECT_URI=https://your-domain.com/callback
VITE_GITHUB_CLIENT_ID=

# ===== TLS (certificate files mounted at deploy/nginx/ssl) =====
DOMAIN=auth.example.com
