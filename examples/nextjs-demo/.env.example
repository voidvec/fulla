# fulla nextjs-demo environment (P1-5 #282).
#
# PUBLIC client values only — the demo deliberately uses the seeded
# fulla-portal PUBLIC client (PKCE, no secret), so nothing here is a
# credential. Copy to .env.local for `next dev` / `next start`.
# The interop e2e runner passes the same variables as process env.

# Where your fulla server runs (docker compose -f deploy/docker/docker-compose.yml up)
FULLA_BASE_URL=http://localhost:5555

# Seeded dev client (apps/server/seed/dev_portal_client.sql) — its registered
# redirect family includes http://localhost:8080/callback, matching this
# demo's pinned port. Do not change without registering a new client.
FULLA_CLIENT_ID=fulla-portal
FULLA_REDIRECT_URI=http://localhost:8080/callback

# Where fulla sends the browser after RP-initiated logout. The server
# validates this against the client's registered redirect family, so it must
# be the callback URI (no standalone post-logout URI is registered for the
# seeded client); /callback without a code just bounces to the demo root.
FULLA_POST_LOGOUT_URI=http://localhost:8080/callback
